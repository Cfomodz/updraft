{
  "manifest_version": 3,
  "name": "Updraft for LinkedIn",
  "short_name": "Updraft",
  "version": "0.1.0",
  "description": "Spot LinkedIn posts gaining momentum while they are still early, and draft comments in your own voice.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "action": { "default_title": "Open Updraft" }
}
